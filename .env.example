# Copy to `.env` and adjust. The backend reads these via pydantic-settings;
# Docker Compose uses the POSTGRES_* values for the local database.

# --- Backend ---
DEBUG=false
DATABASE_URL=postgresql+asyncpg://time_reporting:time_reporting@localhost:5432/time_reporting
DATABASE_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]
# Signs and verifies JWT access tokens. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=
# The web client's session cookie is `Secure` (sent only over HTTPS and to http://localhost).
# Set to false only when serving the web client over plain HTTP from another host.
AUTH_COOKIE_SECURE=true

# --- Docker Compose: PostgreSQL ---
POSTGRES_USER=time_reporting
POSTGRES_PASSWORD=time_reporting
POSTGRES_DB=time_reporting
POSTGRES_PORT=5432
