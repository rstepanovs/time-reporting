# Copy to `.env` and adjust. The backend reads these via pydantic-settings;
# Docker Compose uses the POSTGRES_* values for the local database.

# --- Backend ---
DEBUG=false
DATABASE_URL=postgresql+asyncpg://time_reporting:time_reporting@localhost:5432/time_reporting
DATABASE_ECHO=false
CORS_ORIGINS=["http://localhost:5173"]

# --- Docker Compose: PostgreSQL ---
POSTGRES_USER=time_reporting
POSTGRES_PASSWORD=time_reporting
POSTGRES_DB=time_reporting
POSTGRES_PORT=5432
